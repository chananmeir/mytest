# ==============================================================================
# FAMILY DYNAMICS RPG - API CONFIGURATION
# ==============================================================================

# DEFAULT API KEY (Used as fallback for all characters/systems)
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# GM/NARRATOR SYSTEM (Oversees game logic, consequences, PHS triggers)
# If not set, uses DEFAULT API KEY
GM_API_KEY=your_gm_api_key_here
GM_MODEL=anthropic/claude-3.5-sonnet

# ==============================================================================
# PER-CHARACTER API KEYS (Optional - use different models/keys per character)
# ==============================================================================
# If not set, each character uses DEFAULT API KEY
# This allows you to:
# - Use cheaper models for simpler characters
# - Isolate character conversations
# - Track costs per character

# Ruth (Office Manager) - Guilt-driven, loyal
RUTH_API_KEY=
RUTH_MODEL=anthropic/claude-3.5-sonnet

# Melanie (Nurse Practitioner) - Proud, dismissive [HARDEST]
MELANIE_API_KEY=
MELANIE_MODEL=anthropic/claude-3.5-sonnet

# Tom (IT Technician) - Conflict-avoidant [EASIEST]
TOM_API_KEY=
TOM_MODEL=openai/gpt-4o-mini

# Dawn (Retired Teacher) - Matriarch, passive-aggressive
DAWN_API_KEY=
DAWN_MODEL=anthropic/claude-3.5-sonnet

# Vanessa (Marketing Executive) - Status-conscious
VANESSA_API_KEY=
VANESSA_MODEL=openai/gpt-4o-mini

# Derek (Personal Trainer) - Ego-driven
DEREK_API_KEY=
DEREK_MODEL=openai/gpt-4o-mini

# Karen (School Principal) - Rigid, judgmental
KAREN_API_KEY=
KAREN_MODEL=openai/gpt-4o-mini

# ==============================================================================
# OPTIONAL SETTINGS
# ==============================================================================

# Your site URL and name for OpenRouter rankings
SITE_URL=
SITE_NAME=Family Dynamics RPG

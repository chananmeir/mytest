# ==============================================================================
# FAMILY DYNAMICS RPG - SIMPLE SETUP
# ==============================================================================
#
# QUICK START: Just fill in these two lines and you're done!
#
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# That's it! Everything below is OPTIONAL.
# The game works perfectly with just one API key for all characters.
#
# ==============================================================================

# ==============================================================================
# MEMORY & CONVERSATION SETTINGS (Optional - Defaults Are Good!)
# ==============================================================================
# Only change these if you want to customize memory behavior.
# Defaults work great for most playstyles.

# How much characters remember
# MAX_MEMORIES_PER_CHARACTER=100        # Default: 100 (increase for longer campaigns)
# MEMORY_RETRIEVAL_COUNT=15             # Default: 15 (how many memories per conversation)
# MEMORY_IMPORTANCE_THRESHOLD=3         # Default: 3 (lower = remember more details)

# Auto-consolidate similar memories to prevent redundancy
# MEMORY_CONSOLIDATION_ENABLED=true     # Default: true
# MEMORY_CONSOLIDATION_THRESHOLD=7      # Default: 7

# Conversation history length
# CONVERSATION_HISTORY_LENGTH=30        # Default: 30 (increase for better context)
# USE_CONVERSATION_SUMMARY=false        # Default: false (enable for very long sessions)

# ==============================================================================
# ADVANCED: PER-CHARACTER MODELS (Optional - For Cost Optimization)
# ==============================================================================
# LEAVE THESE BLANK unless you want to use different models per character.
# If blank, all characters use OPENROUTER_MODEL above.
#
# Why use this?
# - Save money by using cheaper models for side characters
# - Use best model only for main characters you interact with most
#
# Example strategy:
# - Main characters (Ruth, Melanie): claude-3.5-sonnet ($3/million tokens)
# - Side characters (Tom, Derek): gpt-4o-mini ($0.15/million tokens) = 20x cheaper!
#
# Ruth (Office Manager) - Main character
# RUTH_MODEL=anthropic/claude-3.5-sonnet

# Melanie (Nurse Practitioner) - Main character [HARDEST]
# MELANIE_MODEL=anthropic/claude-3.5-sonnet

# Tom (IT Technician) - Side character [EASIEST]
# TOM_MODEL=openai/gpt-4o-mini

# Dawn (Retired Teacher) - Side character
# DAWN_MODEL=openai/gpt-4o-mini

# Vanessa (Marketing Executive) - Side character
# VANESSA_MODEL=openai/gpt-4o-mini

# Derek (Personal Trainer) - Side character
# DEREK_MODEL=openai/gpt-4o-mini

# Karen (School Principal) - Side character
# KAREN_MODEL=openai/gpt-4o-mini

# ==============================================================================
# VERY ADVANCED: SEPARATE API KEYS PER CHARACTER (Not Recommended!)
# ==============================================================================
# ⚠️  WARNING: You probably don't want this! ⚠️
#
# These are ONLY useful if you want to:
# - Track API usage separately per character (for analytics)
# - Use different OpenRouter accounts per character
#
# They do NOT give characters separate memory or prevent confusion!
# Characters are already kept separate automatically.
#
# LEAVE THESE BLANK unless you have a specific reason!
#
# RUTH_API_KEY=
# MELANIE_API_KEY=
# TOM_API_KEY=
# DAWN_API_KEY=
# VANESSA_API_KEY=
# DEREK_API_KEY=
# KAREN_API_KEY=

# ==============================================================================
# GM/NARRATOR SYSTEM (Optional - Advanced)
# ==============================================================================
# The GM oversees game logic, consequences, and PHS triggers
# If not set, uses your main OPENROUTER_API_KEY
#
# GM_API_KEY=your_gm_api_key_here
# GM_MODEL=anthropic/claude-3.5-sonnet

# ==============================================================================
# OPTIONAL SETTINGS
# ==============================================================================
# Your site URL and name for OpenRouter rankings
# SITE_URL=
# SITE_NAME=Family Dynamics RPG

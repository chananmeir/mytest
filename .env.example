# ===========================================================================
# MEDXM.AI CONFIGURATION
# ===========================================================================

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# MongoDB Connection URI (default: mongodb://localhost:27017/medxm)
MONGODB_URI=mongodb://localhost:27017/medxm

# Alternative: MongoDB Atlas connection string
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/medxm?retryWrites=true&w=majority


# ===========================================================================
# AI PROVIDERS - Choose Local (free) or Cloud (best accuracy)
# ===========================================================================

# ---------------------------------------------------------------------------
# OPTION 1: CLOUD AI (Azure OpenAI) - Best Accuracy
# ---------------------------------------------------------------------------
# Azure OpenAI API Key (for report generation)
# Get from: https://portal.azure.com
OPENAI_API_KEY=your_azure_openai_api_key_here

# Azure Speech Service (for audio transcription)
# Requires Business Associate Agreement (BAA) with Microsoft for HIPAA compliance
# Get from: https://portal.azure.com
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus


# ---------------------------------------------------------------------------
# OPTION 2: LOCAL AI (Whisper.cpp + Llama.cpp) - Free, Local Control
# ---------------------------------------------------------------------------
# Local Whisper.cpp for audio transcription
WHISPER_BIN=/models/audio/whisper.cpp
WHISPER_MODEL=/models/audio/ggml-base.en.bin

# Local Llama.cpp for report generation
LLAMA_BIN=/models/llm/llama
LLAMA_MODEL=/models/llm/mistral-7b-instruct-v0.1.Q4_0.gguf


# ---------------------------------------------------------------------------
# TEMPORARY FILE STORAGE
# ---------------------------------------------------------------------------
TEMP_AUDIO_DIR=/tmp/audio
TEMP_DIR=/tmp/llama


# ===========================================================================
# HIPAA COMPLIANCE
# ===========================================================================
# Audit log location (for PHI access tracking)
HIPAA_AUDIT_LOG=/secure/phi_audit.log

# Encrypted transcription storage
ENCRYPTED_OUTPUT_DIR=/secure/transcriptions


# ===========================================================================
# SETUP NOTES
# ===========================================================================
#
# QUICK START:
# 1. For cloud-only: Set OPENAI_API_KEY and AZURE_SPEECH_KEY
# 2. For local-only: Install whisper.cpp and llama.cpp, set paths above
# 3. For both: Set all variables for maximum flexibility
#
# HIPAA COMPLIANCE:
# - Azure AI: Requires BAA with Microsoft (see AZURE_HIPAA_SETUP.md)
# - Local AI: No BAA required, 100% on-premise
# - Both options include audit logging and secure file handling
#
# COST COMPARISON:
# - Local: $0 (after initial setup)
# - Azure Speech: ~$1 per hour of audio
# - Azure OpenAI: ~$0.03 per 1K tokens
#
# DOCUMENTATION:
# - Audio transcription: ComfyUI-llama-cpp-cli/AUDIO_TRANSCRIPTION_SETUP.md
# - Azure setup: ComfyUI-llama-cpp-cli/AZURE_HIPAA_SETUP.md
# - HIPAA compliance: ComfyUI-llama-cpp-cli/HIPAA_COMPLIANCE.md
# - Quick start: ComfyUI-llama-cpp-cli/QUICK_START.md
#
# ===========================================================================
